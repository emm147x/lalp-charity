# Copy this file to ".env" and fill in your own values.
# Preferred payment gateway for a Nigerian NGO: Paystack supports NGN and international card payments.
# Keep Stripe as an optional fallback if you also want it enabled.

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
PORT=3000
HOST=0.0.0.0

# Gmail SMTP settings for the contact form.
# To use Gmail, enable 2-Step Verification and generate an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=your_gmail_address@gmail.com
CONTACT_TO=hello@lalpinitiative.org